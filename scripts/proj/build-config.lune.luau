--!strict
-- roleplay + combat are the same game with different switches
-- baked into a generated module so every script (and the type checker) sees the same switches
-- every flag follows the mode by default, but can be forced through an env variable of the same name
-- Services
local fs = require("@lune/fs")
local process = require("@lune/process")
-- Packages
-- Modules
-- Types
-- Constants
local DEFAULT_BUILD_CONFIG_PATH = "Generated/BUILD_CONFIG.luau"
local DEFAULT_MODE = "roleplay"
local COMBAT_FLAGS = { "PVP_ENABLED", "ENERGY_ENABLED", "QUESTS_ENABLED" } -- on in combat, off in roleplay
-- Variables
-- References
-- Private Functions
-- a .env file leaves a variable unset by giving it no value, so an empty string counts as unset
local function getEnv(name: string): string?
	local value = process.env[name]
	if value == nil or value == "" then
		return nil
	end
	return value
end
local function getFlag(name: string, default: boolean): boolean
	local value = getEnv(name)
	if value == nil then
		return default
	end
	assert(value == "true" or value == "false", `{name} must be "true" or "false", received "{value}"`)
	return value == "true"
end
-- Class
do
	local mode = getEnv("MODE") or DEFAULT_MODE
	assert(mode == "roleplay" or mode == "combat", `MODE must be "roleplay" or "combat", received "{mode}"`)
	local lines = {
		"--!strict",
		"-- DO NOT EDIT MANUALLY!! This file was generated by scripts/proj/build-config.lune.luau, edits will likely be overwritten!",
		"return table.freeze({",
		`\tMODE = "{mode}" :: "roleplay" | "combat",`,
	}
	for _, name in COMBAT_FLAGS do
		table.insert(lines, `\t{name} = {getFlag(name, mode == "combat")},`)
	end
	table.insert(lines, "})")
	table.insert(lines, "")

	fs.writeFile(getEnv("BUILD_CONFIG") or DEFAULT_BUILD_CONFIG_PATH, table.concat(lines, "\n"))
end
