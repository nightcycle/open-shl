--!strict
-- every mode is the same game with different switches. a private server takes its switches from whoever set it up
-- once it's running, so its build has the ones of combat off
-- baked into a generated module so every script (and the type checker) sees the same switches
-- every flag follows the mode by default, but can be forced through an env variable of the same name
-- Services
local fs = require("@lune/fs")
local process = require("@lune/process")
-- Packages
-- Modules
-- Types
-- Constants
local DEFAULT_BUILD_CONFIG_PATH = "Generated/BUILD_CONFIG.luau"
-- combat is the place players land in, they pick roleplay from its mode screen
local DEFAULT_MODE = "combat"
local MODES = { "roleplay", "combat", "private-server" }
-- on in combat, off in roleplay
local COMBAT_FLAGS = { "PVP_ENABLED", "ENERGY_ENABLED", "QUESTS_ENABLED", "MODE_SELECT_ENABLED" }
-- Variables
-- References
-- Private Functions
-- a .env file leaves a variable unset by giving it no value, so an empty string counts as unset
local function getEnv(name: string): string?
	local value = process.env[name]
	if value == nil or value == "" then
		return nil
	end
	return value
end
local function getFlag(name: string, default: boolean): boolean
	local value = getEnv(name)
	if value == nil then
		return default
	end
	assert(value == "true" or value == "false", `{name} must be "true" or "false", received "{value}"`)
	return value == "true"
end
-- 0 stands for a place that isn't published yet, whoever teleports there turns the player down instead
local function getPlaceId(name: string): number
	local value = getEnv(name)
	if value == nil then
		return 0
	end
	local placeId = tonumber(value)
	assert(placeId and placeId > 0 and placeId % 1 == 0, `{name} must be a place id, received "{value}"`)
	return placeId
end
-- Class
do
	local mode = getEnv("MODE") or DEFAULT_MODE
	assert(table.find(MODES, mode), `MODE must be one of {table.concat(MODES, ", ")}, received "{mode}"`)
	local modeType = `"{table.concat(MODES, '" | "')}"`
	local lines = {
		"--!strict",
		"-- DO NOT EDIT MANUALLY!! This file was generated by scripts/proj/build-config.lune.luau, edits will likely be overwritten!",
		"return table.freeze({",
		`\tMODE = "{mode}" :: {modeType},`,
	}
	for _, name in COMBAT_FLAGS do
		table.insert(lines, `\t{name} = {getFlag(name, mode == "combat")},`)
	end
	-- off in every mode: the server runs its specs before it starts, only a terminal ever asks it to
	table.insert(lines, `	TESTS_ENABLED = {getFlag("TESTS_ENABLED", false)},`)
	table.insert(lines, `	ROLEPLAY_PLACE_ID = {getPlaceId("ROLEPLAY_PLACE_ID")},`)
	table.insert(lines, `	PRIVATE_SERVER_PLACE_ID = {getPlaceId("PRIVATE_SERVER_PLACE_ID")},`)
	table.insert(lines, "})")
	table.insert(lines, "")

	fs.writeFile(getEnv("BUILD_CONFIG") or DEFAULT_BUILD_CONFIG_PATH, table.concat(lines, "\n"))
end
