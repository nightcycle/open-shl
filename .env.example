# BUILDING
ASPHALT_API_KEY= # allows for asset uploads via open-cloud api

# CI/CD
PUBLISH_ROBLOX_API_KEY= # publishes the places of deploy.yml, it needs universe-places:write on each universe

# OPTIONAL
ROBLOSECURITY= # allows for downloading of certain textures
RESEARCH_ROBLOX_API_KEY= # used during port to give LLM read only access to cloud stuff
