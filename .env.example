# BUILDING
ASPHALT_API_KEY= # allows for asset uploads via open-cloud api

# CI/CD
RUN_ROBLOX_API_KEY= # used publishing and luau execution during the run script
RUN_PLACE_ID= # the place id for remotely running the code
RUN_UNIVERSE_ID= # the universe id for remotely running the code

# MODES
UNIVERSE_ID= # the publish universe id
ROOT_PLACE_ID= # the place built with MODE=combat
ROLEPLAY_PLACE_ID= # the place built with MODE=roleplay, the mode screen of the combat place teleports there
PRIVATE_PLACE_ID= # the place built with MODE=private

# OPTIONAL
ROBLOSECURITY= # allows for downloading of certain textures